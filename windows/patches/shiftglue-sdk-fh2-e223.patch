+  if (!wheel_->haptic) {
+    return;
+  }
+  if (!SDL_StopHapticEffects(wheel_->haptic)) {
+    REXLOG_WARN("SDL wheel: could not stop the forces on focus loss: {}", SDL_GetError());
+  }
+  for (auto& [id, game] : game_effects_) {
+    game.sdl_running = false;
+  }
+  wheel_->last_force = 0;
+  wheel_->last_spring = 0;
+  // With focus back, UpdateWheelSpringLocked sees the title's effects enabled
+  // again and resyncs them, which starts those the title left running.
+  applied_effects_enabled_ = false;
