+"""Compile the production wheel force focus gate with fake haptics.
+
+A wheel base keeps playing the last force it was sent, even after the process
+ends, and ReXApp::OnClosing hard-exits before the SDL driver's OnClosing runs.
+These checks run the production OnLostFocus, OnGotFocus, StopWheelForcesLocked,
+SyncGameEffectsLocked and force paths:
+- losing focus stops every wheel effect and zeroes the base's own rumble;
+- nothing restarts while unfocused, including a driver attached while the
+  window was already unfocused (focus is read from the window first);
+- focus back resumes the title's running effects and its last XInputdFF
+  rumble.
+The window close order (focus loss broadcast to every listener, then
+OnClosing in registration order, the app first) is checked in the production
+sources and replayed against the driver.
+"""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--cxx", required=True)
+parser.add_argument("--out", required=True, type=Path)
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[3]
+
+
+def function(source, signature):
+    start = source.index(signature)
+    return source[start:source.index("\n}", start) + 2] + "\n"
+
+
+def require(passed, why):
+    if not passed:
+        raise SystemExit("FAIL: " + why)
+
+
+# The close order the replay below relies on, read from the production sources.
+window = (root / "src/ui/window.cpp").read_text()
+before_close = function(window, "void Window::OnBeforeClose(")
+require(before_close.index("OnFocusUpdate(false") < before_close.index("listener->OnClosing(e)"),
+        "Window::OnBeforeClose broadcasts the focus loss before OnClosing")
+focus_update = function(window, "void Window::OnFocusUpdate(")
+require("listener->OnLostFocus(e)" in focus_update, "the focus loss reaches every listener")
+require("if (has_focus_ == new_has_focus)" in focus_update,
+        "an unfocused window sends no second focus loss at close (why focus is read at attach)")
+app = (root / "src/ui/rex_app.cpp").read_text()
+require("std::_Exit(0)" in function(app, "void ReXApp::OnClosing("), "the app's OnClosing hard-exits")
+setup = function(app, "bool ReXApp::SetupPresentation(")
+construct = function(app, "bool ReXApp::ConstructRuntime(")
+require("window_->AddListener(this)" in setup and "AttachWindow(window_.get())" in construct,
+        "the app listens before the input system attaches its drivers")
+require(re.search(r"if \(!SetupPresentation\(\)\)[\s\S]*?ConstructRuntime\(", app),
+        "SetupPresentation runs before ConstructRuntime")
+
+mapping = (root / "src/input/sdl/wheel_mapping.cpp").read_text()
+header = (root / "include/rex/input/sdl/wheel_mapping.h").read_text()
+start = header.index("enum class WheelFfbMode")
+enum = header[start:header.index("};", start) + 2]
+source = (root / "src/input/sdl/sdl_input_driver.cpp").read_text()
+available = function(source, "void SDLInputDriver::OnWindowAvailable(")
+require("focused_ = attached_window_->HasFocus();" in available and
+        available.index("focused_ = attached_window_->HasFocus();") < available.index("SDL_InitSubSystem("),
+        "the driver reads the window's focus before any SDL subsystem (and so any wheel) opens")
+harness = r'''
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+#define REXCVAR_GET(name) flag_##name
+#define REXLOG_WARN(...) ((void)0)
+#define REXLOG_INFO(...) ((void)0)
+#define SDL_zero(value) value = {}
+'''
