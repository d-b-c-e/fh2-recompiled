+                   X_ERROR_DEVICE_NOT_CONNECTED = 2;
+X_INPUT_CAPABILITIES Caps(uint16_t flags, uint8_t subtype) {
+  X_INPUT_CAPABILITIES caps{};
+  caps.type = 1;
+  caps.sub_type = subtype;
+  caps.flags = flags;
+  caps.gamepad = {0x3456, 0x78, 0x9a, 900, -123, 456, -789};
+  caps.vibration = {0xabcd, 0x1234};
+  return caps;
+}
+void Expect(const X_INPUT_CAPABILITIES& caps, uint16_t flags, uint8_t subtype) {
+  const auto expected = Caps(flags, subtype);
+  assert(std::memcmp(&caps, &expected, sizeof(caps)) == 0);
+  const auto* bytes = reinterpret_cast<const uint8_t*>(&caps);
+  assert(bytes[2] == (flags >> 8) && bytes[3] == (flags & 0xff));
+}
+struct Device { DeviceId id = 7; X_INPUT_CAPABILITIES caps = Caps(9, 2); void* haptic = nullptr; };
+class SDLInputDriver {
+ public:
