+for signature in ("std::string_view Trim(", "std::string Lower(",
+                  "WheelFfbMode ParseWheelFfbMode("):
+    harness += function(mapping, signature)
+harness += r'''
+using X_RESULT = uint32_t;
+constexpr X_RESULT X_ERROR_SUCCESS = 0, X_ERROR_FUNCTION_FAILED = 1;
+constexpr uint32_t SDL_HAPTIC_CONSTANT = 1, SDL_HAPTIC_SPRING = 2, SDL_HAPTIC_SINE = 4;
+constexpr int SDL_HAPTIC_STEERING_AXIS = 2, SDL_HAPTIC_INFINITY = 3;
+constexpr uint32_t kRumbleDurationMs = 0xFFFF;
+int flag_wheel_ffb_strength = 25, flag_wheel_ffb_centering = 50, flag_wheel_ffb_rumble = 50;
+int flag_wheel_ffb_rumble_road = 100, flag_wheel_ffb_rumble_engine = 100;
+int flag_wheel_ffb_spring = 100, flag_wheel_ffb_damper = 100;
+int flag_wheel_ffb_friction = 100, flag_wheel_ffb_inertia = 100;
+bool flag_wheel_ffb_invert = false, flag_wheel_ffb_effects = true, flag_wheel_log_inputs = false;
