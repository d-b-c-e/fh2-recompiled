+  struct {struct {int type{};} direction; int length{};
+    uint16_t right_sat[1]{}, left_sat[1]{};
+    int16_t right_coeff[1]{}, left_coeff[1]{};} condition;
+  struct {struct {int type{};} direction; int length{}; int period{}; int16_t magnitude{};} periodic;
+};
+int creates = 0, updates = 0, runs = 0, stops = 0, stop_alls = 0, rumbles = 0, checks = 0;
+uint32_t rumble_low = 0, rumble_high = 0, rumble_ms = 0;
