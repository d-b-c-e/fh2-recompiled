+  return left ? 1000 : 0;
+}
+const char* WheelFfbModeName(WheelFfbMode) { return "mode"; }
+namespace ffb_trace { void NoteWheelOutput(int, const char*) {} }
+namespace rex::ui { struct UISetupEvent {}; }
+struct X_INPUT_VIBRATION { uint16_t left_motor_speed{}, right_motor_speed{}; };
+struct WheelState {
+  SDL_Haptic* haptic = nullptr;
+  int constant_effect = -1, rumble_effect = -1, spring_effect = -1;
+  int16_t last_force = 0;
+  int last_spring = 0;
+  uint32_t haptic_features = SDL_HAPTIC_CONSTANT | SDL_HAPTIC_SPRING | SDL_HAPTIC_SINE;
+  uint16_t logged_left = 0, logged_right = 0;
+};
+struct GameEffect { int sdl_id = -1; bool running = false, sdl_running = false; };
+struct WheelJoystick { SDL_Joystick* sdl = nullptr; };
+struct SDLInputDriver {
+  SDL_Haptic device;
+  SDL_Joystick stick;
+  WheelJoystick joystick{&stick};
+  bool has_base = true;
+  std::atomic<bool> focused_{true};
+  bool SDL_Gamepad_initialized_ = true, sdl_haptic_initialized_ = true;
+  std::optional<WheelState> wheel_;
+  std::map<uint32_t, GameEffect> game_effects_;
+  std::vector<int> controllers_{1, 2};
+  // As applied at the flags above, so only an enable change resyncs.
+  int applied_effect_strength_ = 25, applied_condition_gains_ = 100 * 1000003 + 100 * 1009 + 100 * 31 + 100;
+  bool applied_effect_invert_ = false, applied_effects_enabled_ = true;
+  uint16_t game_rumble_left_ = 0, game_rumble_right_ = 0;
+  std::mutex mutex;
+  int locks = 0, released = 0;
+  SDLInputDriver() { wheel_.emplace(); wheel_->haptic = &device; }
+  std::unique_lock<std::mutex> DrainAndLock() { ++locks; return std::unique_lock<std::mutex>(mutex); }
+  bool ReleaseFeedbackLocked(int&, bool = false) { ++released; return true; }
+  WheelJoystick* FindWheelJoystick(std::string_view, bool) { return has_base ? &joystick : nullptr; }
+  // The production rule for one title effect, reduced to start and stop.
+  void ApplyGameEffectLocked(GameEffect& game) {
+    if (!GameEffectsEnabled()) {
+      if (game.sdl_running) SDL_StopHapticEffect(wheel_->haptic, game.sdl_id);
+      game.sdl_running = false;
+      return;
+    }
+    if (game.running && !game.sdl_running) game.sdl_running = SDL_RunHapticEffect(wheel_->haptic, game.sdl_id, 1);
+  }
+  bool GameEffectsEnabled() const;
+  void StopWheelForcesLocked();
+  void SyncGameEffectsLocked();
+  void UpdateWheelSpringLocked();
+  void ApplyRumbleLocked();
+  X_RESULT SetWheelVibrationLocked(const X_INPUT_VIBRATION& vibration);
+  void OnLostFocus(rex::ui::UISetupEvent&);
+  void OnGotFocus(rex::ui::UISetupEvent&);
+  bool mutex_held() { if (mutex.try_lock()) { mutex.unlock(); return false; } return true; }
+};
+void check(bool passed, const char* why) {
+  ++checks;
+  if (!passed) { std::cerr << "FAIL: " << why << '\n'; std::exit(1); }
+}
+'''
+for signature in ("bool SDLInputDriver::GameEffectsEnabled() const",
+                  "void SDLInputDriver::StopWheelForcesLocked()",
+                  "void SDLInputDriver::SyncGameEffectsLocked()",
+                  "void SDLInputDriver::UpdateWheelSpringLocked()",
+                  "void SDLInputDriver::ApplyRumbleLocked()",
+                  "X_RESULT SDLInputDriver::SetWheelVibrationLocked(",
+                  "void SDLInputDriver::OnLostFocus(",
+                  "void SDLInputDriver::OnGotFocus("):
+    harness += function(source, signature)
+harness += r'''
+int main() {
+  rex::ui::UISetupEvent event;
+  {
+    // Focused: the title's force, spring and rumble play.
+    SDLInputDriver driver;
+    driver.game_effects_[1] = {3, true, true};
+    driver.UpdateWheelSpringLocked();
+    check(driver.wheel_->last_spring == 50 && runs == 1, "focused: centering spring runs");
+    driver.game_effects_.clear();
+    check(driver.SetWheelVibrationLocked({4000, 0}) == X_ERROR_SUCCESS && driver.wheel_->last_force == 1000,
+          "focused: the title's motors drive a constant force");
+    driver.game_effects_[1] = {3, true, true};
+    driver.game_rumble_left_ = 30000;
+    driver.ApplyRumbleLocked();
+    check(driver.wheel_->rumble_effect == 7, "focused: the title's rumble plays");
+
+    // Focus lost: every effect stops and the base's rumble is zeroed, under the driver's lock.
+    const int locks = driver.locks, alls = stop_alls, rb = rumbles;
+    driver.OnLostFocus(event);
+    check(!driver.focused_ && driver.locks == locks + 1 && stop_alls == alls + 1, "focus loss stops every wheel effect");
+    check(rumbles == rb + 1 && rumble_low == 0 && rumble_high == 0, "focus loss zeroes the base's own rumble");
+    check(driver.wheel_->last_force == 0 && driver.wheel_->last_spring == 0 &&
+          !driver.game_effects_[1].sdl_running && driver.game_effects_[1].running,
+          "the title's intent is kept, the host state reads stopped");
+    check(driver.released == 2, "gamepad feedback still released as before");
+
+    // Unfocused: nothing starts or updates.
+    const int r = runs, c = creates, u = updates, rb2 = rumbles;
+    check(!driver.GameEffectsEnabled(), "the title's effects are refused while unfocused");
+    driver.UpdateWheelSpringLocked();
+    driver.UpdateWheelSpringLocked();
+    driver.ApplyRumbleLocked();
+    driver.game_effects_.clear();
+    check(driver.SetWheelVibrationLocked({4000, 4000}) == X_ERROR_SUCCESS, "unfocused vibration is accepted");
+    driver.game_effects_[1] = {3, true, false};
+    check(runs == r && creates == c && updates == u && rumbles == rb2 && driver.wheel_->last_force == 0,
+          "unfocused: no force, spring or rumble runs");
+
+    // Focus back: the title's running effect and its last rumble resume at once, the spring on the next update.
+    const int runs_before = runs;
+    driver.OnGotFocus(event);
+    check(driver.focused_ && driver.game_effects_[1].sdl_running && driver.applied_effects_enabled_,
+          "focus back resumes the title's running effects");
+    check(runs == runs_before + 2, "focus back also resumes the title's last rumble");
+    driver.UpdateWheelSpringLocked();
+    check(driver.wheel_->last_spring == 50, "the next wheel update restores the saved centering");
+    check(flag_wheel_ffb_strength == 25 && flag_wheel_ffb_centering == 50, "force settings are unchanged");
+  }
+  {
+    // XInputdFF rumble alone (no title effects): the same values are not sent again, focus back replays them.
+    SDLInputDriver driver;
+    driver.game_rumble_left_ = 20000;
+    driver.ApplyRumbleLocked();
+    driver.OnLostFocus(event);
+    const int r = runs;
+    driver.OnGotFocus(event);
+    check(runs == r + 1, "rumble-only: focus back resumes the last rumble");
+  }
+  {
+    // Mode "rumble" with title effects: the effects stay off, the rumble resumes.
+    flag_wheel_ffb_mode = "rumble";
+    SDLInputDriver driver;
+    driver.game_effects_[1] = {3, true, false};
+    driver.game_rumble_right_ = 20000;
+    driver.OnLostFocus(event);
+    const int r = runs;
+    driver.OnGotFocus(event);
+    check(runs == r + 1 && !driver.game_effects_[1].sdl_running, "rumble mode: rumble resumes, effects stay off");
+    flag_wheel_ffb_mode = "difference";
+  }
+  {
+    // A base with no haptics rumbles from the title's motors; focus loss zeroes it.
+    flag_wheel_ffb_mode = "rumble";
+    SDLInputDriver driver;
+    driver.wheel_->haptic = nullptr;
+    driver.game_effects_.clear();
+    driver.SetWheelVibrationLocked({4000, 0});
+    check(rumble_low != 0 && rumble_ms == kRumbleDurationMs, "no haptic: the motors rumble the base");
+    const int alls = stop_alls;
+    driver.OnLostFocus(event);
+    check(rumble_low == 0 && rumble_high == 0 && rumble_ms == 0 && stop_alls == alls,
+          "no haptic: focus loss zeroes the base's rumble, no haptic call");
+    flag_wheel_ffb_mode = "difference";
+  }
+  {
+    // No wheel, or no base joystick: focus loss stays inert, gamepads are still released.
+    SDLInputDriver driver;
+    driver.has_base = false;
+    driver.wheel_->haptic = nullptr;
+    const int rb = rumbles, alls = stop_alls;
+    driver.OnLostFocus(event);
+    driver.wheel_.reset();
+    driver.focused_ = true;
+    driver.OnLostFocus(event);
+    driver.OnGotFocus(event);
+    check(rumbles == rb && stop_alls == alls && driver.released == 4, "nothing to stop: inert, gamepads released");
+  }
+  {
+    // Attached while the window was already unfocused (focus read from the window): nothing ever plays,
+    // so a close with no focus transition (no OnLostFocus) leaves nothing running.
+    SDLInputDriver driver;
+    driver.focused_ = false;
+    driver.game_rumble_left_ = 30000;
+    const int r = runs, c = creates, rb = rumbles;
+    driver.UpdateWheelSpringLocked();
+    driver.ApplyRumbleLocked();
+    driver.SetWheelVibrationLocked({4000, 4000});
+    check(runs == r && creates == c && rumbles == rb && driver.wheel_->last_force == 0 &&
+          driver.wheel_->last_spring == 0, "attached unfocused: no force, spring or rumble before focus");
+  }
+  {
+    // Window close, as the production sources order it: the focus loss goes to every listener (app
+    // first, then the driver), then OnClosing in the same order, where the app hard-exits first.
+    SDLInputDriver driver;
+    driver.wheel_->last_force = 1000;
+    std::vector<std::string> trace;
+    const int alls = stop_alls;
+    trace.push_back("app focus");
+    driver.OnLostFocus(event);
+    trace.push_back(stop_alls == alls + 1 ? "driver stopped" : "driver running");
+    trace.push_back("app closing: _Exit");
+    check(trace[1] == "driver stopped" && !driver.mutex_held(), "the wheel stops before the hard exit, lock released");
+  }
+  std::cout << checks << " focus checks passed (production gate/force paths, fake haptics)\n";
+}
+'''
+args.out.mkdir(parents=True, exist_ok=True)
+fixture = args.out.resolve() / "wheel_focus_seam.cpp"
+executable = args.out.resolve() / "wheel_focus_seam.exe"
+fixture.write_text(harness)
+subprocess.run([args.cxx, "-std=c++17", "-Wall", "-Wextra", "-Werror",
+                str(fixture), "-o", str(executable)], check=True)
+subprocess.run([str(executable)], check=True)
