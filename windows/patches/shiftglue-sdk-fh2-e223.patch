+  void QueueControllerUpdate() { queued = true; }
+  Guard DrainAndLock() { assert(queued); locked = true; return {locked}; }
+  Device* FindController(DeviceId id) { assert(locked); return pad_connected && id == pad.id ? &pad : nullptr; }
+  void UpdateXCapabilities(Device&) { assert(locked); }
+  X_RESULT GetDeviceCapabilities(DeviceId, uint32_t, X_INPUT_CAPABILITIES*);
