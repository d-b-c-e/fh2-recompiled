diff --git a/tests/unit/input/device_path_seam.py b/tests/unit/input/device_path_seam.py
new file mode 100644
index 00000000..602bb428
--- /dev/null
+++ b/tests/unit/input/device_path_seam.py
@@ -0,0 +1,113 @@
+"""Compile actual SDL admission prefixes with fake opens; no SDL or devices."""
+import argparse
+from pathlib import Path
+import subprocess
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--cxx", required=True, help="C++ compiler in a configured build environment")
+parser.add_argument("--out", required=True, type=Path)
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[3]
+source = (root / "src/input/sdl/sdl_input_driver.cpp").read_text()
+
+
+def prefix(name, last_line):
+    start = source.index(f"void SDLInputDriver::{name}(")
+    end = source.index(last_line, start) + len(last_line)
+    return source[start:end] + "\n}\n"
+
+
+configure_start = source.index("bool SDLInputDriver::ConfigureDevicePaths(")
+configure_end = source.index("\n}\n", configure_start) + 3
+methods = source[configure_start:configure_end]
+methods += prefix("OnControllerDeviceAddedLocked",
+                  "const auto controller = SDL_OpenGamepad(event.gdevice.which);")
+methods += prefix("OnJoystickAddedLocked", "SDL_Joystick* sdl = SDL_OpenJoystick(which);")
+# Discard the opened fake handles, where the remainder of each real handler begins.
+methods = methods.replace("const auto controller =", "[[maybe_unused]] const auto controller =")
+methods = methods.replace("SDL_Joystick* sdl =", "[[maybe_unused]] SDL_Joystick* sdl =")
+
+harness = r'''
+#include <rex/input/device_path_policy.h>
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+#define REXLOG_INFO(...) ((void)0)
+using rex::input::DevicePathPolicy;
+using SDL_JoystickID = int;
+struct SDL_Event { struct { int which = 1; } gdevice, jdevice; };
+struct SDL_Joystick {};
+const char* candidate_path = nullptr;
+int gamepad_opens = 0, joystick_opens = 0, path_reads = 0, checks = 0;
+const char* SDL_GetJoystickPathForID(int) { ++path_reads; return candidate_path; }
+void* SDL_OpenGamepad(int) { ++gamepad_opens; return nullptr; }
+SDL_Joystick* SDL_OpenJoystick(int) { ++joystick_opens; return nullptr; }
+struct SDLInputDriver {
+  void* attached_window_ = nullptr;
+  bool sdl_events_initialized_ = false, path_policy_installed_ = false, wheel_part = false;
+  DevicePathPolicy path_policy_;
+  struct WheelJoystick { int instance_id; };
+  std::vector<WheelJoystick> wheel_joysticks_;
+  bool IsWheelPart(int) { return wheel_part; }
+  bool ConfigureDevicePaths(const DevicePathPolicy&);
+  void OnControllerDeviceAddedLocked(const SDL_Event&);
+  void OnJoystickAddedLocked(const SDL_Event&);
+};
+void check(bool passed, const char* why) {
+  ++checks;
+  if (!passed) { std::cerr << "FAIL: " << why << '\n'; std::exit(1); }
+}
+'''
+harness += methods
+harness += r'''
+void arrival(const char* path, bool install, bool wheel, bool duplicate,
+             int expected_gamepad, int expected_raw) {
+  SDLInputDriver driver;
+  driver.wheel_part = wheel;
+  if (duplicate) driver.wheel_joysticks_.push_back({1});
+  if (install) check(driver.ConfigureDevicePaths({{"BOUND"}}), "install before attachment");
+  candidate_path = path;
+  gamepad_opens = joystick_opens = path_reads = 0;
+  driver.OnControllerDeviceAddedLocked({});
+  driver.OnJoystickAddedLocked({});
+  check(gamepad_opens == expected_gamepad, "gamepad admission");
+  check(joystick_opens == expected_raw, "raw joystick admission");
+  check(install || path_reads == 0, "default does not query paths");
+}
+int main() {
+  for (const char* path : std::vector<const char*>{nullptr, "", "BOUND", "bound", "other"}) {
+    arrival(path, false, false, false, 1, 0);
+    arrival(path, false, true, false, 0, 1);
+  }
+  for (const char* path : std::vector<const char*>{nullptr, "", "BOUND", "bound"}) {
+    arrival(path, true, false, false, 0, 0);
+    arrival(path, true, true, false, 0, 0);
+  }
+  arrival("other", true, false, false, 1, 0);
+  arrival("other", true, true, false, 0, 1);
+  arrival("BOUND-more", true, true, false, 0, 1);
+  arrival("other", true, true, true, 0, 0);
+  SDLInputDriver driver;
+  check(driver.ConfigureDevicePaths({{"BOUND"}}), "initial policy");
+  driver.attached_window_ = &driver;
+  check(!driver.ConfigureDevicePaths({}), "refuse after attachment");
+  check(!driver.path_policy_.Allows("bound"), "refused update retains exclusions");
+  driver.attached_window_ = nullptr;
+  driver.sdl_events_initialized_ = true;
+  check(!driver.ConfigureDevicePaths({}), "refuse after SDL initialization");
+  driver.sdl_events_initialized_ = false;
+  check(driver.ConfigureDevicePaths({}), "rollback before attachment");
+  check(driver.path_policy_.Allows("BOUND"), "empty policy restores admission");
+  check(driver.path_policy_.Allows(""), "empty policy permits unknown paths");
+  check(DevicePathPolicy{{"first", "BOUND"}}.Allows("other"), "unrelated device");
+  check(!DevicePathPolicy{{"first", "BOUND"}}.Allows("bound"), "second excluded path");
+  std::cout << checks << " admission checks passed (production prefixes, fake opens)\n";
+}
+'''
+args.out.mkdir(parents=True, exist_ok=True)
+fixture = args.out.resolve() / "device_path_seam.cpp"
+executable = args.out.resolve() / "device_path_seam.exe"
+fixture.write_text(harness)
+subprocess.run([args.cxx, "-std=c++17", "-Wall", "-Wextra", "-Werror",
+                "-I", str(root / "include"), str(fixture), "-o", str(executable)], check=True)
+subprocess.run([str(executable)], check=True)
