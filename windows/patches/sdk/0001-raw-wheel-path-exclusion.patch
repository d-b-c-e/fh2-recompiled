 /// Exercises assignment with no SDL, window, or OS behind it.
-class FakeDriver final : public InputDriver {
+class FakeDriver : public InputDriver {
  public:
   FakeDriver() : InputDriver(nullptr, 0) {}
 
@@ -263,3 +263,32 @@ TEST_CASE("A synthetic device does not push the first pad off guest user 0", "[i
   REQUIRE(static_cast<uint16_t>(state.gamepad.buttons) == X_INPUT_GAMEPAD_B);
   REQUIRE(system->GetState(1, &state) == X_ERROR_DEVICE_NOT_CONNECTED);
 }
+
+TEST_CASE("Device path admission is opt-in and pre-attach", "[input][device-paths]") {
+  class PathDriver final : public FakeDriver {
+   public:
+    int calls = 0;
+    rex::input::DevicePathPolicy policy;
+    bool ConfigureDevicePaths(const rex::input::DevicePathPolicy& value) override {
+      ++calls;
+      policy = value;
+      return true;
+    }
+  };
+  InputSystem system(nullptr);
+  system.AddDriver(std::make_unique<FakeDriver>());  // Unsupported by default.
+  const rex::input::DevicePathPolicy policy{{"BOUND"}};
+  REQUIRE(system.ConfigureDevicePaths(policy) == 0);
+  auto driver = std::make_unique<PathDriver>();
+  auto* observed = driver.get();
+  system.AddDriver(std::move(driver));
+  REQUIRE(observed->calls == 0);
+  REQUIRE(system.ConfigureDevicePaths(policy) == 1);
+  REQUIRE(observed->calls == 1);
+  REQUIRE_FALSE(observed->policy.Allows("bound"));
+  // FakeDriver's window callback is a no-op; the sentinel is never dereferenced.
+  system.AttachWindow(reinterpret_cast<rex::ui::Window*>(uintptr_t(1)));
+  REQUIRE(system.ConfigureDevicePaths({}) == 0);
+  REQUIRE(observed->calls == 1);
+  REQUIRE_FALSE(observed->policy.Allows("bound"));
+}
