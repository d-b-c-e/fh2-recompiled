diff --git a/include/rex/input/device_path_policy.h b/include/rex/input/device_path_policy.h
new file mode 100644
index 00000000..25b4eb77
--- /dev/null
+++ b/include/rex/input/device_path_policy.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rex::input {
+
+// Optional, per-driver admission installed before window attachment. These are
+// exact OS interface paths, not SDL model GUIDs or VID/PID matches.
+struct DevicePathPolicy {
+  std::vector<std::string> excluded_paths;
+
+  bool Allows(std::string_view path) const {
+    // With isolation enabled an unidentifiable new SDL candidate is withheld;
+    // this does not change admission or state of other devices.
+    if (!excluded_paths.empty() && path.empty()) return false;
+    auto lower = [](char c) { return c >= 'A' && c <= 'Z' ? char(c + ('a' - 'A')) : c; };
+    for (const auto& excluded : excluded_paths) {
+      if (excluded.empty() || path.size() != excluded.size()) continue;
+      bool same = true;
+      for (std::size_t i = 0; i < path.size(); ++i) same &= lower(path[i]) == lower(excluded[i]);
+      if (same) return false;
+    }
+    return true;
+  }
+};
+
+}  // namespace rex::input
